{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimflow.dev/contracts/event-envelope.schema.json",
  "title": "ClaimFlow Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 8 },
    "event_type": {
      "type": "string",
      "pattern": "^(policy|claim|payment)\\.[a-z_]+$"
    },
    "event_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 8 },
    "payload": { "type": "object" }
  }
}

