{
  "name": "ClaimFlow Lakehouse",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "python -m pip install -e '.[dev]'",
  "forwardPorts": [8000, 8501, 8080, 3000, 9090],
  "portsAttributes": {
    "8000": {
      "label": "Analytics API"
    },
    "8501": {
      "label": "Operations Dashboard"
    },
    "8080": {
      "label": "Redpanda Console"
    },
    "3000": {
      "label": "Grafana"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "innoverio.vscode-dbt-power-user"
      ]
    }
  }
}
